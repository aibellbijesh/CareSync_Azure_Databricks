{
	"name": "PL_SOURCE_TO_SILVER_MAIN",
	"properties": {
		"activities": [
			{
				"name": "GET SOURCE TABLE LIST",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT TABLE_ID FROM CTRL.table_config WHERE IS_ACTIVE =1 AND SOURCE_SYSTEM = '@{pipeline().parameters.SOURCE_SYSTEM}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AZURESQLTABLE",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GET SOURCE TABLE LIST",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GET SOURCE TABLE LIST').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "INNNER PIPELINE",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "INSERT IN PROGRESS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_SOURCE_TO_SILVER_INNER",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"Table_Id": {
										"value": "@item().TABLE_ID",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "INSERT IN PROGRESS",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "insert  into ctrl.audit_log (adf_run_id,table_id,stage,status,start_time)\nvalues ('a1', @{item().TABLE_ID}, 'SOURCE_TO_SILVER', 'IN_PROGRESS', SYSUTCDATETIME())\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "UPDATE ON FAILURE",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "INNNER PIPELINE",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query"
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"SOURCE_SYSTEM": {
				"type": "string",
				"defaultValue": "neon_postgres"
			}
		},
		"variables": {
			"Test_variable": {
				"type": "String"
			}
		},
		"annotations": []
	}
}